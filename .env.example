# ====================================================================
# PROJET PERMIS BÉNIN — Environment variables
# Copy this file to `.env` and fill in real values.
# On Vercel, set the same variables in Project Settings → Environment Variables.
# ====================================================================

# --- Database (Neon serverless PostgreSQL) ---
# Get these from your Neon dashboard → Project → Connection Details.
# DATABASE_URL  = pooled connection (port 6543, pgbouncer) → used by the app at runtime
# DIRECT_URL    = direct connection (port 5432)             → used by Prisma CLI (db push / migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Email (Resend) ---
# Create a free key at https://resend.com/api-keys
# Used by /api/contact to email inscription notifications.
# Leave empty to disable email (the form still falls back to WhatsApp).
RESEND_API_KEY=""
CONTACT_EMAIL="contact@projetpermisenin.bj"

# --- NextAuth (optional, only if you add auth later) ---
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="https://projet-permis-benin.vercel.app"
